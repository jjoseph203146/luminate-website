# Luminate TEST STORE — environment variables
# Set these in Vercel → Project → Settings → Environment Variables (never commit real values).
# For local runs with `vercel dev`, copy to .env.local (already git-ignored).
# Every name starts with TEST_STORE_ so none can collide with a production variable.

# Master switch. The store does nothing unless this is exactly "true".
TEST_STORE_ENABLED=true

# Stripe — SANDBOX ONLY. Keys that are not sk_test_/rk_test_ are refused by the code.
TEST_STORE_STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# From the webhook endpoint you create in the Stripe SANDBOX (starts with whsec_)
TEST_STORE_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Supabase — a SEPARATE test project (not Luminate OS). The service-role key stays server-side only.
TEST_STORE_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
TEST_STORE_SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Resend
TEST_STORE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
TEST_STORE_NOTIFY_EMAIL=you@example.com
# Optional. Default is Resend's shared test sender (onboarding@resend.dev), which can only deliver to the
# email address on your own Resend account. Use a verified-domain address to send anywhere.
# TEST_STORE_FROM_EMAIL=Luminate Test Store <orders@yourdomain.com>

# Admin page (/test-store/admin)
TEST_STORE_ADMIN_PASSWORD=choose-a-long-random-password
# Random string, 32+ characters, used to sign the admin session cookie. e.g. `openssl rand -hex 32`
TEST_STORE_SESSION_SECRET=paste-a-long-random-string

# Optional: lets an external scheduler call POST /api/test-store/retry-notifications with
# "Authorization: Bearer <this value>". Not needed — retries also run after every order.
# TEST_STORE_RETRY_SECRET=another-long-random-string

# Optional: force the base URL used for Stripe's success/cancel redirects.
# TEST_STORE_SITE_URL=https://luminatewebdesign.com
