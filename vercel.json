{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web-design-augusta-ga/index.html",
      "destination": "/web-design-augusta-ga",
      "permanent": true
    },
    {
      "source": "/contractor-website-design-augusta-ga/index.html",
      "destination": "/contractor-website-design-augusta-ga",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/web-design-augusta-ga",
      "destination": "/web-design-augusta-ga/index.html"
    },
    {
      "source": "/contractor-website-design-augusta-ga",
      "destination": "/contractor-website-design-augusta-ga/index.html"
    },
    {
      "source": "/test-store",
      "destination": "/test-store/index.html"
    },
    {
      "source": "/test-store/admin",
      "destination": "/test-store/admin/index.html"
    },
    {
      "source": "/test-contact",
      "destination": "/test-contact/index.html"
    }
  ],
  "headers": [
    {
      "source": "/test-contact",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/test-contact/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
